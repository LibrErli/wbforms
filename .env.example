# wbforms configuration template.
# Copy to `.env` and fill in / override values. All variables are read
# by pydantic-settings at startup (prefix: WBFORMS_). The `.env` file is
# looked up in the project root and the current working directory; set
# WBFORMS_ENV_FILE (as a real environment variable) to load a different
# file instead, e.g. WBFORMS_ENV_FILE=.env.factgrid

# --- Wikibase endpoints (override to target a different Wikibase instance) ---
WBFORMS_WIKIBASE_WEBSITE=https://ceur-dev.wikibase.cloud/
WBFORMS_WIKIBASE_SPARQL_ENDPOINT=https://ceur-dev.wikibase.cloud/query/sparql
WBFORMS_WIKIBASE_ITEM_PREFIX=https://ceur-dev.wikibase.cloud/entity/
WBFORMS_WIKIBASE_PROPERTY_PREFIX=https://ceur-dev.wikibase.cloud/prop/direct/
WBFORMS_WIKIBASE_MEDIAWIKI_API_URL=https://ceur-dev.wikibase.cloud/w/api.php
WBFORMS_WIKIBASE_MEDIAWIKI_REST_URL=https://ceur-dev.wikibase.cloud/w/rest.php

# --- Schema (LinkML schema driving model + router codegen) ---
# Path to the LinkML schema YAML the app loads at startup. Defaults to the
# bundled `ceur_graph.yaml`. To deploy with a different schema, point this
# at the alternative file (in Docker, bind-mount it and set this to the
# in-container path).
# WBFORMS_SCHEMA_PATH=/app/src/wbforms/schema/ceur_graph.yaml

# --- OAuth consumer (register at <wikibase>/wiki/Special:OAuthConsumerRegistration/propose) ---
# If you comment out all WBFORMS_OAUTH_* entries, wbforms provides you a simple login form to login to your Wikibase
WBFORMS_OAUTH_VERSION=2.0
WBFORMS_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback
WBFORMS_OAUTH_CLIENT_ID=
WBFORMS_OAUTH_CLIENT_SECRET=


# --- App ---
WBFORMS_APP_BASE_URL=http://localhost:8000/
WBFORMS_SESSION_TTL_MINUTES=60

# --- Request Headers ---
WBFORMS_REQUEST_HEADER_USER_AGENT=wbforms/1.0 (Wikibase Forms Editor)